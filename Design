7. PostgreSQL Relational Schema Blueprints
SQL

CREATE TABLE guests (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    rsvp_status VARCHAR(50) DEFAULT 'Pending', -- 'Attending', 'Declining', 'Pending'
    dietary_requirements TEXT DEFAULT NULL,
    added_by_guest_id UUID DEFAULT NULL,       -- Matches family rows together cleanly
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);CREATE TABLE media_gallery (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    url TEXT NOT NULL,                         -- Target storage bucket URL
    media_type VARCHAR(20) NOT NULL,           -- 'image' or 'video'
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);CREATE TABLE song_requests (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    song_title VARCHAR(255) NOT NULL,
    artist VARCHAR(255) NOT NULL,
    requested_by_name VARCHAR(200) NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);CREATE TABLE guestbook_messages (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    guest_name VARCHAR(200) NOT NULL,
    message_text TEXT NOT NULL,
    is_private BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

